# Incident Commander API base URL (default: same-origin /api via Vite proxy in dev)
# VITE_API_URL=http://localhost:8080/api

# Vite dev server proxy target when using default VITE_API_URL=/api
# VITE_API_PROXY_TARGET=http://localhost:8080

# Bearer token when INCIDENT_COMMANDER_API_TOKEN is set on the API server
# VITE_API_TOKEN=your-secret-token
