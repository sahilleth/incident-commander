# Groq LLM — primary key; optional fallback when primary is rate-limited
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# SQLite database path
INCIDENT_DB_PATH=./data/incidents.db

# Kubernetes — requires kubectl and cluster access
KUBECONFIG=
KUBE_CONTEXT=kind-incident-commander

# Logs: loki (after ./scripts/setup-observability.sh) | kubectl tails pod logs
LOG_BACKEND=loki
LOKI_URL=http://localhost:3100

# Prometheus metrics (kube-state-metrics queries — override for app http_requests_total)
PROMETHEUS_URL=http://localhost:9090
PROM_ERROR_RATE_QUERY=sum(rate(kube_pod_container_status_restarts_total{namespace="{namespace}", pod=~"{service}.*"}[5m])) * 100
PROM_P99_LATENCY_QUERY=vector(0)
PROM_REQUEST_RATE_QUERY=count(kube_pod_info{namespace="{namespace}", pod=~"{service}.*"})

# Orchestrator limits
MAX_WORKER_ITERATIONS=5
WORKER_TIMEOUT_SECONDS=120
KUBECTL_TIMEOUT_SECONDS=30

# Post-mitigation verification loop
VERIFY_MAX_ATTEMPTS=5
VERIFY_INTERVAL_SECONDS=15
VERIFY_MAX_ERROR_COUNT=10
DEPLOY_LOOKBACK_MINUTES=30
